# ---- Data and credentials (added 2026-09-01) ----
# The rules above covered .env and .streamlit/secrets.toml but nothing data-shaped.
# A `git add -A` would previously have committed any CSV, spreadsheet or stats file
# sitting in the working tree.

# Tabular and statistical data
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.sav
*.dta
*.rds
*.rda
*.parquet
*.feather
*.pkl
*.sqlite
*.sqlite3
*.db

# Common data directories
data/
files/
raw/
exports/

# Profiling reports embed real values (distributions, extremes, sample rows),
# not merely structure. They are data files wearing an HTML extension.
pandas_profile.html
*_profile.html
*profile_report.html
*_report.html
ydata_profiling_report.html

# Auth config holds password hashes and the cookie signing key.
# Commit a redacted config.yaml.example instead.
st_auth/config.yaml
**/auth/config.yaml
secrets.json
*.secrets.json
*.pem
*.key

# Allow small committed reference tables by exception, for example:
# !reference/country_codes.csv

# Local-only PyGWalker chart specs (may contain dataset column names)
viz_config/*.json
